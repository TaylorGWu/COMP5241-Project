  "narrative": {
    "northStar": "Make teaching decisions visible.",
    "overview": "Extend the incumbent Coursework system: navy ink, restrained blue actions, light blue-grey surfaces. Home/profile/application use scoped Manrope headings, Source Sans 3 body and locale-appropriate Noto Sans SC/TC; course editing and authentication retain Geist. The interface gives material, review and decisions distinct places. Authentication uses a focused form on the left and a quiet photographic learning-studio illustration on the right, retaining the shared brand and control vocabulary.\n\nThis is an extraction of the current system, not a rebrand. Sources are `frontend/app/globals.css`, `frontend/app/public.css`, `frontend/components/ui.tsx`, `PublicHeader.tsx`, `PublicHome.tsx`, `AuthScreen.tsx`, `AuthScreen.module.css` and `AccountPages.tsx`. The approved surface composition and narrative remain in `docs/design/public-entry-interface.md`; they are not mandatory layouts for every new screen.",
    "keyCharacteristics": [
      "Light surfaces separated by fine borders and modest tonal changes.",
      "Blue actions, green acceptance and amber review/revision feedback.",
      "Compact, legible operational controls with larger public headings.",
      "Real text and code in demonstrations; visible human review states."
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "Green means acceptance and amber means review or revision; do not use either as an unrelated marketing accent.",
        "section": "colors"
      },
      {
        "name": "The Readable Example Rule",
        "body": "Reflow demonstration content on small screens before reducing its text size.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reuse semantic theme variables, including the homepage teaching section, across light and dark modes.",
      "Do distinguish approved, pending and revision states with visible text as well as color.",
      "Do reflow examples, forms and review actions into a readable mobile sequence.",
      "Do preserve visible keyboard focus and reduced-motion access to the complete content."
    ],
    "donts": [
      "Don't replace the approved scoped type system or carry public display typography into the course editor.",
      "Don't replace readable text/code demonstrations with raster artwork containing labels.",
      "Don't add visual proof such as logos, testimonials, adoption numbers or progress that the product cannot substantiate."
    ]
  }
