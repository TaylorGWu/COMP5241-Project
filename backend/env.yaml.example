# 复制为 env.yaml 并填入真实值。
#
# env.yaml 已被 .gitignore 忽略,不会进仓库。
# 不要把它贴进聊天记录或截图。
#
# 优先级(见 app/config.py 的 settings_customise_sources):
#     显式传参 > 环境变量 > env.yaml > secrets 文件
# 也就是说:**生产环境走环境变量,env.yaml 只作本地开发的兜底。**
# 这样同一份代码在本地和部署平台都能跑,且部署时不需要带任何 yaml。

app_env: development

database_url: postgresql+asyncpg://postgres:postgres@localhost:5432/comp5241
redis_url: redis://localhost:6379

# 模型凭据
deepseek_api_key: ""
deepseek_base_url: https://api.deepseek.com
deepseek_model: deepseek-flash
deepseek_vision_model: deepseek-flash
# 思考模式。关掉 temperature 才生效;详见 app/config.py 的说明
deepseek_thinking: false

gemini_api_key: ""
siliconflow_api_key: ""
